<h1 class="page-title">All Notes</h1>
<div class="notes-grid">
    {{#each payload}}

    <div class="note-card hover-card">
        <h3>{{noteName}}</h3>
        <p class="note-desc">{{description}}</p>
        <span class="status {{status}}">{{status}}</span>
        <div class="card-actions hidden">
            <a href="/api/{{_id}}" class="btn view"> View</a>
            <a href="/api/edit/{{_id}}" class="btn edit">Edit</a>
            <a href="/api/delete/{{_id}}" class="btn delete">Delete</a>
        </div>
    </div>
    {{else}}
    <p class="empty-msg">No Notes to display.. Create Your First Note.</p>
    {{/each}}
</div>